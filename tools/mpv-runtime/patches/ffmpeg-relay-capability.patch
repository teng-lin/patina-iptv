+static int patina_relay_allowed(URLContext *uc)
+{
+    const char *prefix = uc->patina_http_prefix;
+    if (!prefix || !prefix[0])
+        return 1;
+    const char *url = uc->filename;
+    if (!strcmp(uc->prot->name, "crypto")) {
+        if (!av_strstart(url, "crypto+", &url) &&
+            !av_strstart(url, "crypto:", &url))
+            return 0;
+    } else if (strcmp(uc->prot->name, "http")) {
+        // The only permitted non-HTTP IO is the TCP transport opened by a
+        // validated HTTP context. A demuxer cannot enable this private flag.
+        return !strcmp(uc->prot->name, "tcp") && uc->patina_tcp_transport;
+    }
+    return av_strstart(url, prefix, NULL);
+}
