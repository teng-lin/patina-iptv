{
  "name": "Patina",
  "id": "com.hantekllc.iptvrs",
  "icon": "icon.png",
  "appearance": "dark",
  "statusBar": {
    "hidden": true
  },
  "rust": ".",
  "root": "App",
  "features": [],
  "window": {
    "defaultSize": {
      "width": 1280,
      "height": 720
    }
  },
  "macos": {
    "infoPlist": {
      "NSLocalNetworkUsageDescription": "Finds nearby Chromecast devices and streams video to the TV you choose.",
      "NSBonjourServices": [
        "_googlecast._tcp"
      ]
    }
  },
  "ios": {
    "infoPlist": {
      "UIDeviceFamily": [
        2
      ],
      "UISupportedInterfaceOrientations": [
        "UIInterfaceOrientationPortrait",
        "UIInterfaceOrientationPortraitUpsideDown",
        "UIInterfaceOrientationLandscapeLeft",
        "UIInterfaceOrientationLandscapeRight"
      ],
      "UISupportedInterfaceOrientations~ipad": [
        "UIInterfaceOrientationPortrait",
        "UIInterfaceOrientationPortraitUpsideDown",
        "UIInterfaceOrientationLandscapeLeft",
        "UIInterfaceOrientationLandscapeRight"
      ],
      "NSLocalNetworkUsageDescription": "Plays and reads playlists from servers on your local network.",
      "NSAppTransportSecurity": {
        "NSAllowsArbitraryLoads": true,
        "NSAllowsArbitraryLoadsForMedia": true
      }
    }
  },
  "version": "0.1.10",
  "schemes": [
    "patina"
  ]
}
